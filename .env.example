# "Start a project" form → email (api/contact.js). Copy to .env.local for local testing,
# and add the same variables in Vercel → Project → Settings → Environment Variables.
#
# GMAIL_APP_PASSWORD is a Google *App Password* (16 letters), not the account password:
# Google Account → Security → 2-Step Verification (turn on) → App passwords → create one.
GMAIL_USER=apheleia.team@gmail.com
GMAIL_APP_PASSWORD=
# where enquiries are delivered (defaults to apheleia.team@gmail.com)
CONTACT_TO=apheleia.team@gmail.com
